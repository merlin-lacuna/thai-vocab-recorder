# Copy to /etc/thai-quiz/env on the server (owner thaiquiz, mode 600).
# This file holds secrets. Never commit the real file: the repository is public.
QUIZ_SEND_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Google Workspace address, and a Google app password for it (not the normal password).
SMTP_USER=
SMTP_PASS=
# MAIL_FROM must be the Workspace address itself; Google rewrites other addresses.
MAIL_FROM=
MAIL_TO=
